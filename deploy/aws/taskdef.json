{
  "family": "care-ride-backend",
  "networkMode": "awsvpc",
  "cpu": "256",
  "memory": "512",
  "requiresCompatibilities": ["FARGATE"],
  "executionRoleArn": "arn:aws:iam::726591790830:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::726591790830:role/care-ride-task-role",
  "containerDefinitions": [
    {
      "name": "backend",
      "image": "REPLACE_ECR_URI",
      "essential": true,
      "portMappings": [
        { "containerPort": 8080, "protocol": "tcp" }
      ],
      "environment": [
        { "name": "SPRING_PROFILES_ACTIVE", "value": "prod" },
        { "name": "AWS_REGION", "value": "us-east-1" },
        { "name": "AWS_SES_FROM_EMAIL", "value": "contact@careridesolutionspa.com" },
        { "name": "MAIL_FROM", "value": "contact@careridesolutionspa.com" },
        { "name": "MAIL_NOTIFY", "value": "contact@careridesolutionspa.com" }
      ],
      "secrets": [
        { "name": "SPRING_DATASOURCE_URL", "valueFrom": "arn:aws:ssm:us-east-1:726591790830:parameter/SPRING_DATASOURCE_URL" },
        { "name": "SPRING_DATASOURCE_USERNAME", "valueFrom": "arn:aws:ssm:us-east-1:726591790830:parameter/SPRING_DATASOURCE_USERNAME" },
        { "name": "SPRING_DATASOURCE_PASSWORD", "valueFrom": "arn:aws:ssm:us-east-1:726591790830:parameter/SPRING_DATASOURCE_PASSWORD" },
        { "name": "JWT_SECRET", "valueFrom": "arn:aws:ssm:us-east-1:726591790830:parameter/JWT_SECRET" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/care-ride-backend",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
  "healthCheck": null
    }
  ]
}
