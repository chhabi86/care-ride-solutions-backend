MAIL_FROM=contact@careridesolutionspa.com
MAIL_STARTTLS_ENABLE=true
MAIL_STARTTLS_REQUIRED=true
MAIL_DEBUG=false

# AWS SES HTTP API Configuration (bypasses SMTP port blocking)
